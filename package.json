{
  "name": "skills-plugin-bun",
  "version": "0.0.0",
  "description": "Template for Agent Skills backed by Bun TypeScript scripts",
  "packageManager": "bun@1.3.14",
  "type": "module",
  "private": true,
  "scripts": {
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "check": "biome check . && bun run typecheck",
    "fix": "biome check --write .",
    "prepare": "husky"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.15",
    "@types/bun": "1.3.14",
    "husky": "9.1.7",
    "typescript": "6.0.3"
  }
}
